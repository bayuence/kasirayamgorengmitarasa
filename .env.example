# Konfigurasi Supabase Client (dibaca oleh aplikasi web di browser via Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Konfigurasi Supabase Presensi Donattour (opsional: untuk login karyawan)
VITE_PRESENSI_SUPABASE_URL=
VITE_PRESENSI_SUPABASE_ANON_KEY=

# Koneksi Langsung PostgreSQL (khusus perkakas pengembang Drizzle ORM / scripts, TIDAK untuk browser)
DATABASE_URL=

# Supabase Personal Access Token (PAT) untuk script migrasi & seed
SUPABASE_ACCESS_TOKEN=

